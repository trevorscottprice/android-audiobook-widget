<?xml version="1.0" encoding="utf-8"?>
<!-- The 2x2 as a cover tile: laid out exactly like the plain 2x2, with the art
     edge to edge behind it. White whatever the theme, since what is behind the
     text is the art, not the widget colour; a fade at the top and bottom and
     shadows under the text keep it legible on light covers. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_art"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/preview_cover" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_edges" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/text_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="@color/on_art_shadow"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="@string/preview_title"
                android:textColor="@color/on_art_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:text="@string/preview_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/on_art_shadow"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="@color/on_art_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/rewind_btn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/btn_skip">

                <!-- Two copies of the arc: showing the other one spins it in, which is
                     how a widget gets to animate. See WidgetRender.paintSkip. -->
                <ViewFlipper
                    android:id="@+id/rewind_spin"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:inAnimation="@anim/spin_back">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_rewind"
                        android:src="@drawable/ic_arc_back"
                        android:tint="@color/on_art_text" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_rewind"
                        android:src="@drawable/ic_arc_back"
                        android:tint="@color/on_art_text" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/rewind_label"
                    android:text="@string/preview_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/on_art_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/play_pause_btn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_circle">

                <ImageView
                    android:id="@+id/play_pause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_play_pause"
                    android:src="@drawable/ic_play" />

                <!-- Stands in for the icon while a stopped player is being woken. -->
                <ProgressBar
                    android:id="@+id/play_busy"
                    style="@android:style/Widget.Material.ProgressBar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/btn_fg"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/forward_btn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/btn_skip">

                <!-- Two copies of the arc: showing the other one spins it in, which is
                     how a widget gets to animate. See WidgetRender.paintSkip. -->
                <ViewFlipper
                    android:id="@+id/forward_spin"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:inAnimation="@anim/spin_forward">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_forward"
                        android:src="@drawable/ic_arc_forward"
                        android:tint="@color/on_art_text" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_forward"
                        android:src="@drawable/ic_arc_forward"
                        android:tint="@color/on_art_text" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/forward_label"
                    android:text="@string/preview_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/on_art_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <include layout="@layout/widget_clock_on_art" />
    </LinearLayout>
</FrameLayout>
