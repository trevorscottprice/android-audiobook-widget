<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/text_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/preview_title"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:text="@string/preview_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/rewind_btn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_skip">

            <!-- Two copies of the arc: showing the other one spins it in, which is
                 how a widget gets to animate. See WidgetRender.paintSkip. -->
            <ViewFlipper
                android:id="@+id/rewind_spin"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:inAnimation="@anim/spin_back">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_rewind"
                    android:src="@drawable/ic_arc_back" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_rewind"
                    android:src="@drawable/ic_arc_back" />
            </ViewFlipper>

            <TextView
                android:id="@+id/rewind_label"
                android:text="@string/preview_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/play_pause_btn"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/btn_circle">

            <ImageView
                android:id="@+id/play_pause"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_play_pause"
                android:src="@drawable/ic_play" />

            <!-- Stands in for the icon while a stopped player is being woken. -->
            <ProgressBar
                android:id="@+id/play_busy"
                style="@android:style/Widget.Material.ProgressBar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/btn_fg"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/forward_btn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_skip">

            <!-- Two copies of the arc: showing the other one spins it in, which is
                 how a widget gets to animate. See WidgetRender.paintSkip. -->
            <ViewFlipper
                android:id="@+id/forward_spin"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:inAnimation="@anim/spin_forward">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_forward"
                    android:src="@drawable/ic_arc_forward" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_forward"
                    android:src="@drawable/ic_arc_forward" />
            </ViewFlipper>

            <TextView
                android:id="@+id/forward_label"
                android:text="@string/preview_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/widget_clock" />
</LinearLayout>
