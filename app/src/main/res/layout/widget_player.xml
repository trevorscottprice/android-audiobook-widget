<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/cd_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/preview_cover" />

        <!-- Fills the row height: title pinned top, controls absorb the slack
             below. Without this the column floats and leaves dead bands above
             and below. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/text_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/preview_title"
                    android:textColor="@color/widget_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:text="@string/preview_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="68dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/rewind_btn"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/btn_skip">

                    <!-- Two copies of the arc: showing the other one spins it in, which is
                         how a widget gets to animate. See WidgetRender.paintSkip. -->
                    <ViewFlipper
                        android:id="@+id/rewind_spin"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:inAnimation="@anim/spin_back">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_rewind"
                            android:src="@drawable/ic_arc_back" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_rewind"
                            android:src="@drawable/ic_arc_back" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/rewind_label"
                        android:text="@string/preview_skip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/widget_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/play_pause_btn"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_circle">

                    <ImageView
                        android:id="@+id/play_pause"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_play_pause"
                        android:src="@drawable/ic_play" />

                    <!-- Stands in for the icon while a stopped player is being woken. -->
                    <ProgressBar
                        android:id="@+id/play_busy"
                        style="@android:style/Widget.Material.ProgressBar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/btn_fg"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/forward_btn"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/btn_skip">

                    <!-- Two copies of the arc: showing the other one spins it in, which is
                         how a widget gets to animate. See WidgetRender.paintSkip. -->
                    <ViewFlipper
                        android:id="@+id/forward_spin"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:inAnimation="@anim/spin_forward">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_forward"
                            android:src="@drawable/ic_arc_forward" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_forward"
                            android:src="@drawable/ic_arc_forward" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/forward_label"
                        android:text="@string/preview_skip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/widget_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_clock" />
</LinearLayout>
